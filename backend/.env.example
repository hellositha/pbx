# ECLYPETECH PBX Environment Configuration
NODE_ENV=production
PORT=4000
HOST=127.0.0.1

# Database Configuration (PostgreSQL 18)
DATABASE_URL="postgresql://eclypetech:EclypeTechDB2026!@127.0.0.1:5432/eclypetech_pbx?schema=public"

# Authentication & Security Secrets
JWT_SECRET="eclypetech_pbx_super_secret_jwt_key_2026_enterprise_production"
JWT_EXPIRES_IN="8h"
AES_SECRET_KEY="eclypetech_aes_256_telephony_secret_key_32bytes"

# Asterisk Telephony Engine Configuration
ASTERISK_AMI_HOST="127.0.0.1"
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER="eclype"
ASTERISK_AMI_SECRET="EclypeAmiSecret123!"

# Telephony Paths & Domain
PBX_CONF_DIR="/etc/asterisk"
PBX_RECORDINGS_DIR="/var/recordings/pbx"
PBX_BACKUPS_DIR="/var/backups/eclypetech"
PBX_DOMAIN="127.0.0.1"
PBX_SIP_PORT=5060
PBX_WSS_PORT=5066
